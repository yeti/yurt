{
  "name": "backend",
  "version": "0.1.0",
  "description": "",
  "main": "server.ts",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "generate": "pnpm generate:prisma && pnpm generate:nexus",
    "generate:nexus": "tsx src/schema.ts",
    "generate:prisma": "prisma generate",
    "migrate": "prisma migrate dev && prisma generate",
    "migrate:create": "pnpm prisma migrate dev --create-only",
    "dev": "nodemon",
    "lint": "eslint --ext .ts src",
    "migrate:deploy": "prisma migrate deploy && prisma generate",
    "build": "pnpm install --prod=false && pnpm generate && tsc && resolve-tspaths && pnpm migrate:deploy",
    "test": "NODE_ENV=test pnpm migrate:test && vitest run",
    "test:watch": "DATABASE_URL=postgresql://prisma:prisma@localhost:5434/tests vitest",
    "test:ui": "DATABASE_URL=postgresql://prisma:prisma@localhost:5434/tests vitest --ui",
    "seed": "tsx prisma/seed.ts",
    "migrate:test": "DATABASE_URL=postgresql://prisma:prisma@localhost:5434/tests prisma migrate dev && prisma generate",
    "db:test:start": "docker-compose -p test -f ../../docker-compose.jest.yml down && docker-compose -p test -f ../../docker-compose.jest.yml up -d"
  },
  "keywords": [],
  "author": "",
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@as-integrations/express5": "^1.1.2",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@sentry/node": "^8.55.0",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-oauth2-jwt-bearer": "^1.6.0",
    "graphql": "^16.11.0",
    "graphql-middleware": "^6.1.35",
    "graphql-shield": "^7.6.5",
    "helmet": "^8.1.0",
    "nanoid": "^3.3.7",
    "nexus": "^1.3.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-pretty": "^13.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@swc/core": "^1.13.5",
    "@swc/helpers": "^0.5.17",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9.34.0",
    "eslint-plugin-unicorn": "^51.0.1",
    "nodemon": "^3.0.1",
    "prisma": "^7.2.0",
    "regenerator-runtime": "^0.14.0",
    "resolve-tspaths": "^0.8.15",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^4.0.15",
    "vitest-mock-extended": "^3.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
